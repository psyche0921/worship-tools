# deploy/.env 로 복사해서 채운다(권한 600, git에 넣지 않음).
# Gemini API 키. 키 제한은 'Generative Language API'로만(서버 호출이라 웹사이트 제한은 동작하지 않음)
GEMINI_API_KEY=
# Google Cloud OAuth 웹 클라이언트 ID(사이트 로그인에 쓴다. ID 토큰만 받고 다른 범위는 쓰지 않는다)
GOOGLE_CLIENT_ID=
# 관리자 이메일(쉼표로 구분). 팀원은 관리자가 화면의 설정 탭에서 추가한다
ADMIN_EMAILS=
# (선택) YouTube Data API 키. 자동 쇼츠 기획이 최근 영상을 찾을 때 먼저 쓴다.
# 없으면 채널 '실시간' 탭 페이지를 읽는다(키 없이 되지만 유튜브가 바뀌면 깨질 수 있음)
YOUTUBE_API_KEY=
PUBLIC_ORIGIN=https://bbc.ppsoft.kr
DEFAULT_MODEL=gemini-3.8-flash
# 팀원 1명이 하루에 할 수 있는 쇼츠 기획 횟수(관리자는 제한 없음)
DAILY_PLAN_LIMIT=20
# 악보 한 파일의 크기 제한(MB). **nginx의 client_max_body_size(25m)보다 작아야 한다** —
# 더 크게 두면 nginx가 먼저 413으로 막아서 앱의 안내가 나오지 않는다.
# 비워 두면 기본값 20을 쓴다
MAX_SHEET_MB=20
# drdr(채보 학습)가 새 세트리스트를 찾아 가는 목록의 비밀 키(drdr의 DRDR_WORSHIP_FEED_TOKEN과 같은 값).
# 비우면 목록이 꺼진다. 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
DRDR_FEED_TOKEN=
# (선택) BBC Score(찬양팀 악보 필기 앱) 연동. 둘 다 BBC Score 쪽 .env와 맞춘다.
# SCORE_ORIGIN: 앱 주소. 공유 페이지·세트리스트 결과에 '찬양팀 악보 앱에서 열기'가 생긴다(임시 주소, 정식 도메인이 나오면 바꾼다)
# SCORE_API_KEY: BBC Score 서버가 찬양팀 명단·세트리스트 목록을 읽을 때 쓰는 키(python -c "import secrets;print(secrets.token_urlsafe(32))")
SCORE_ORIGIN=https://score.ppsoft.kr
SCORE_API_KEY=
