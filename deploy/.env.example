# deploy/.env 로 복사해서 채운다(권한 600, git에 넣지 않음).
# Gemini API 키. 키 제한은 'Generative Language API'로만(서버 호출이라 웹사이트 제한은 동작하지 않음)
GEMINI_API_KEY=
# Google Cloud OAuth 웹 클라이언트 ID(사이트 로그인과 YouTube 재생목록에 같이 씀)
GOOGLE_CLIENT_ID=
# 관리자 이메일(쉼표로 구분). 팀원은 관리자가 화면의 설정 탭에서 추가한다
ADMIN_EMAILS=
# (선택) YouTube Data API 키. 자동 쇼츠 기획이 최근 영상을 찾을 때 먼저 쓴다.
# 없으면 채널 '실시간' 탭 페이지를 읽는다(키 없이 되지만 유튜브가 바뀌면 깨질 수 있음)
YOUTUBE_API_KEY=
PUBLIC_ORIGIN=https://bbc.ppsoft.kr
DEFAULT_MODEL=gemini-3.8-flash
# 팀원 1명이 하루에 할 수 있는 쇼츠 기획 횟수(관리자는 제한 없음)
DAILY_PLAN_LIMIT=20
